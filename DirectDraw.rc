    POPUP "Map View"
    BEGIN
        MENUITEM "맵 속성보기",                 IDM_ATTRIBUTE_VIEW
    END
    POPUP "Set"
    BEGIN
        MENUITEM "Action && FPS",               IDM_SET
    END
END


